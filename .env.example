# Copy to `.env` and fill in. NEVER commit the real .env file.

# ── App ──────────────────────────────────────────────
APP_NAME="ExcelAI Dashboard"
# true = dev mode: auto-creates tables, verbose logs, allows weak secrets.
DEBUG=true
CORS_ORIGINS=["http://localhost:5173"]

# ── Database (PostgreSQL) ────────────────────────────
POSTGRES_USER=excelai
POSTGRES_PASSWORD=change-me-db-password
POSTGRES_DB=excelai_db
DATABASE_URL=postgresql://excelai:change-me-db-password@localhost:5432/excelai_db
ASYNC_DATABASE_URL=postgresql+asyncpg://excelai:change-me-db-password@localhost:5432/excelai_db

# ── Redis (cache + Celery broker) ────────────────────
REDIS_URL=redis://localhost:6379/0

# ── File storage ─────────────────────────────────────
# "local" writes to ./uploads (simplest); "minio" uses the MinIO service below.
STORAGE_BACKEND=local
LOCAL_STORAGE_DIR=uploads
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=change-me-minio-secret
MINIO_BUCKET=excelai-files
MINIO_SECURE=false

# ── AI (optional: the app runs without it, AI features return 503) ──
# AI_PROVIDER: "anthropic" or "groq" (free tier)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-4-6
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── JWT auth ─────────────────────────────────────────
# Required (>= 32 chars) when DEBUG=false. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
